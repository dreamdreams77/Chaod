{
  "name": "chaos-exe",
  "version": "3.5.0",
  "private": true,
  "type": "module",
  "description": "CHAOS.exe: the 90s gaming multiverse",
  "scripts": {
    "dev": "node dev.mjs",
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "esbuild tests/*.test.ts --bundle --platform=node --format=esm --outdir=.test-out --log-level=warning && node --test .test-out/*.test.js",
    "seeds": "esbuild scripts/seeds.ts --bundle --platform=node --format=esm --outfile=.test-out/seeds.mjs --log-level=warning && node .test-out/seeds.mjs",
    "check": "npm run typecheck && npm run test && npm run build",
    "smoke": "python3 scripts/smoke.py"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0"
  }
}
